[sub_resource type="Resource" id="choice_mercy"]
script = ExtResource("3")
choice_id = "justice_needs_mercy"
text = "Justice without mercy only creates another wrong."
destination_node_id = "mercy_response"
requires_confirmation = true
actions = Array[ExtResource("4")]([SubResource("set_met"), SubResource("set_mercy"), SubResource("play_intro_mercy")])

[sub_resource type="Resource" id="start"]
script = ExtResource("2")
node_id = "start"
speaker_npc_id = "justice_commander"
text = "You fought your way to this command post. Before I place soldiers under your banner, tell me: what does justice demand?"
editor_position = Vector2(40, 80)
choices = Array[ExtResource("3")]([SubResource("choice_duty"), SubResource("choice_mercy")])

[sub_resource type="Resource" id="duty_response"]
script = ExtResource("2")
node_id = "duty_response"
speaker_npc_id = "justice_commander"
text = "Then carry the weight of every answer you demand. Welcome to the line."
editor_position = Vector2(470, 20)
ends_conversation = true

[sub_resource type="Resource" id="mercy_response"]
script = ExtResource("2")
node_id = "mercy_response"
speaker_npc_id = "justice_commander"
text = "A dangerous answer in this army—and perhaps the one it most needs. Welcome to the line."
editor_position = Vector2(470, 180)
ends_conversation = true

[resource]
script = ExtResource("1")
conversation_id = "justice_commander_intro"
display_name = "Justice Commander Audience"
