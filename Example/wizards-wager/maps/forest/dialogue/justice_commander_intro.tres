[sub_resource type="Resource" id="set_met"]
script = ExtResource("4")
action_id = "set_commander_met"
target_id = "justice_commander_met"

[sub_resource type="Resource" id="set_duty"]
script = ExtResource("4")
action_id = "set_duty_response"
target_id = "justice_oath_response"
text_value = "duty"
requires_confirmation = true

[sub_resource type="Resource" id="play_intro_duty"]
script = ExtResource("4")
action_id = "play_justice_intro_duty"
action_type = "start_cinematic"
target_id = "justice_commander_audience"

[sub_resource type="Resource" id="choice_duty"]
script = ExtResource("3")
choice_id = "justice_is_duty"
text = "Justice means answering every wrong."
destination_node_id = "duty_response"
requires_confirmation = true
actions = Array[ExtResource("4")]([SubResource("set_met"), SubResource("set_duty"), SubResource("play_intro_duty")])

[sub_resource type="Resource" id="set_mercy"]
script = ExtResource("4")
action_id = "set_mercy_response"
target_id = "justice_oath_response"
text_value = "mercy"
requires_confirmation = true

[sub_resource type="Resource" id="play_intro_mercy"]
script = ExtResource("4")
action_id = "play_justice_intro_mercy"
action_type = "start_cinematic"
