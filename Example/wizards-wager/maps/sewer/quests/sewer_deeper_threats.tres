[resource]
script = ExtResource("1_quest")
quest_id = "sewer_deeper_threats"
giver_npc_id = "sewer_guide"
title = "Deeper Threats"
description = "Drive back three goblins and three skeletons, then return."
offer_text = "Goblins are stripping the old passages, and Skeletons guard the way out. Clear three of each."
completion_text = "The surface route is open. What waits above is worse than anything down here—and it can choose whom to hate."
prerequisite_quest_ids = PackedStringArray("sewer_first_hunt")
rewards = {
"gold": 20,
"xp": 40
}
stages = Array[ExtResource("2_stage")]([SubResource("goblin_stage"), SubResource("skeleton_stage"), SubResource("return_stage")])
